# Configurações do servidor Apache para KingHost
DirectoryIndex index.html index.php

# Regras de URL
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirecionar para HTTPS apenas no domínio próprio com certificado (evita erro no endereço alternativo .kinghost.net)
  RewriteCond %{HTTP_HOST} !\.kinghost\.net$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Suporte a diretórios com barra final
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/ [L,R=301]
</IfModule>

# Página de Erro 404
ErrorDocument 404 /404.html

# Compressão Gzip para velocidade
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de Navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
